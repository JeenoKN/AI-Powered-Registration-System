# 1. ใช้ Node.js เวอร์ชัน 20 แบบตัวเบาเป็นฐานในการรันเว็บ
FROM node:22-alpine

# 2. ตั้งโฟลเดอร์ทำงานหลักข้างในตู้คอนเทนเนอร์
WORKDIR /app

# 3. ก๊อปปี้ไฟล์รายการ Library ของหน้าบ้านเข้าไปก่อนเพื่อเตรียมติดตั้ง
COPY package*.json ./

# 4. สั่งติดตั้ง Library ทั้งหมดของฝั่ง Vue.js (node_modules)
RUN npm install

# 5. ก๊อปปี้ซอร์สโค้ดฝั่งหน้าบ้านทั้งหมดตามเข้าไปในตู้
COPY . .

# 6. เปิดพอร์ต 5173 ซึ่งเป็นพอร์ตมาตรฐานของ Vite / Vue 3
EXPOSE 5173

# 7. สั่งรันเว็บโหมดพัฒนา และเปิดตัวยึด --host ให้ภายนอกเชื่อมต่อเข้ามาหน้าเว็บได้
CMD ["npm", "run", "dev", "--", "--host"]