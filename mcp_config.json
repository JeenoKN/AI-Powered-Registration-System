{
  "mcpServers": {
    "docker-manager": {
      "command": "npx",
      "args": ["-y", "mcp-server-docker"]
    },
    "mongodb-newsystem": {
      "command": "npx",
      "args": [
        "-y",
        "mongodb-mcp-server",
        "--connectionString",
        "mongodb://localhost:27018/NewSystem"
      ]
    }
  }
}